/** Original short texts: 10 activities per grade and area, 60 in total. */
function literacyBank_(){
  const out=[];
  function word(grade,target,passage){out.push({grade,kind:'word',title:'문맥 속 낱말 · '+target,passage,target,hint:'낱말 앞뒤의 행동이나 상황을 단서로 뜻을 짐작하세요. 단서를 쓰고, 이 낱말을 넣어 나만의 문장을 만드세요.'});}
  function sentence(grade,title,passage,target){out.push({grade,kind:'sentence',title:'문장 연결 · '+title,passage,target,hint:'두 문장이 어떤 관계인지 먼저 생각하세요. 제시된 표현을 참고해 자연스럽게 연결하고, 그 표현을 고른 까닭을 쓰세요.'});}
  function paragraph(grade,title,passage){out.push({grade,kind:'paragraph',title:'문단 읽기 · '+title,passage,target:'',hint:'여러 문장을 두루 설명하는 중심 문장을 찾으세요. 구체적인 예를 모두 옮기기보다 중요한 내용을 1~2문장으로 간추리고, 더 생각할 질문을 만드세요.'});}
  [
    ['협력','우리 모둠은 커다란 전시판을 혼자 만들기 어렵다고 생각했다. 그래서 한 명은 글을 쓰고, 다른 친구들은 그림과 꾸미기를 맡아 협력했다. 서로 맡은 일을 해내자 전시판이 완성되었다.'],
    ['배려','다리를 다친 친구가 계단 앞에서 멈췄다. 수아는 서두르지 않고 친구의 속도에 맞추어 걸으며 가방도 들어 주었다. 친구의 어려움을 헤아린 수아의 배려가 고마웠다.'],
    ['망설이다','지호는 발표할 생각에 손을 조금 들었다가 다시 내렸다. 틀리면 어쩌나 걱정되어 선뜻 나서지 못하고 망설였다. 친구의 응원을 듣고 나서야 손을 번쩍 들었다.'],
    ['궁리하다','종이 다리가 자꾸 가운데에서 휘어졌다. 우리는 종이를 접어 볼지, 받침을 더 놓을지 여러 방법을 궁리했다. 마침내 주름을 만들어 접은 뒤 다시 시험했다.'],
    ['차근차근','설명서가 길어 보여 처음에는 만들기를 포기하고 싶었다. 하지만 부품을 나누고 첫 단계부터 하나씩 차근차근 따라 했다. 순서대로 하니 복잡한 모형도 완성할 수 있었다.'],
    ['꾸준하다','민서는 하루에 그림을 한 장씩 그렸다. 잘 그려지지 않는 날에도 연습을 거르지 않고 두 달을 이어 갔다. 선생님은 민서의 꾸준한 노력을 칭찬했다.'],
    ['한결','책과 공책이 뒤섞인 책상에서는 준비물을 찾기 어려웠다. 과목별로 정리한 뒤에는 필요한 것을 바로 꺼낼 수 있었다. 책상을 정리하니 공부 준비가 한결 수월해졌다.'],
    ['살피다','우리는 교실을 나서기 전에 창문과 전등을 살폈다. 창문이 잠겼는지, 켜진 전등이 없는지 하나씩 확인했다. 확인을 마친 뒤 문을 닫았다.'],
    ['뿌듯하다','한 달 동안 연습한 줄넘기를 오늘 처음으로 스무 번 연속 넘었다. 중간에 여러 번 실패했지만 포기하지 않은 결과였다. 내 힘으로 해냈다는 생각에 마음이 뿌듯했다.'],
    ['어림하다','상자 안의 구슬을 하나씩 세기 전에 대강 몇 개인지 생각해 보았다. 작은 컵 하나에 열 개쯤 들어가는 것을 보고 전체를 쉰 개 정도로 어림했다. 나중에 정확히 세어 예상과 비교했다.']
  ].forEach(([target,text])=>word(5,target,text));
  [
    ['근거','다은이는 운동장에 나무 그늘이 더 필요하다고 주장했다. 그늘이 없는 곳에서 쉬기 어렵다는 설문 결과와 관찰 기록을 근거로 들었다. 친구들은 주장을 뒷받침하는 자료를 함께 살펴보았다.'],
    ['타당하다','도서관 이용 시간을 늘리자는 의견이 나왔다. 실제 이용 학생 수와 관리할 수 있는 시간을 함께 따져 보니 실행할 만한 이유가 충분했다. 우리는 그 제안이 타당하다고 판단했다.'],
    ['상충하다','한 친구는 행사 시간을 줄여 수업 시간을 확보하자고 했다. 다른 친구는 행사를 더 길게 열어 많은 활동을 하자고 했다. 두 요구가 서로 반대 방향을 향해 상충하자, 우리는 우선순위를 다시 의논했다.'],
    ['보완하다','안내문에 행사 장소와 날짜는 있었지만 준비물 설명이 빠져 있었다. 우리는 빠진 내용을 덧붙여 안내문을 보완했다. 처음 쓴 내용을 모두 버리지 않고 부족한 부분을 채운 것이다.'],
    ['숙고하다','새 모둠 규칙을 바로 정하면 일부 친구가 불편할 수 있었다. 우리는 각 규칙의 좋은 점과 어려운 점을 적고 충분히 숙고했다. 여러 결과를 곰곰이 생각한 뒤 규칙을 정했다.'],
    ['수렴하다','학급 문집의 이름을 정하려고 모든 친구의 의견을 모았다. 비슷한 의견은 묶고, 각 이름을 제안한 까닭도 들었다. 이렇게 의견을 수렴한 뒤 후보 세 개를 골랐다.'],
    ['관점','같은 축제를 보고도 상인은 손님이 늘었다는 점을 이야기했다. 주민은 늦은 시간의 소음을 먼저 이야기했다. 자신이 처한 자리에서 바라보는 관점에 따라 중요하게 보는 점이 달랐다.'],
    ['절충하다','한 모둠은 발표를 연극으로 하자고 했고, 다른 모둠은 그림 자료를 보여 주자고 했다. 우리는 짧은 연극 뒤에 그림으로 내용을 정리하는 방법으로 절충했다. 두 의견의 일부를 함께 살린 것이다.'],
    ['신중하다','출처가 분명하지 않은 소문을 친구에게 전하려던 순간, 유나는 사실인지 먼저 확인했다. 확인되지 않은 말이 다른 사람에게 피해를 줄 수 있다고 생각했기 때문이다. 유나는 정보를 전할 때 신중했다.'],
    ['편견','서준이는 조용한 친구는 발표도 잘하지 못할 것이라고 생각했다. 하지만 그 친구는 준비한 내용을 또렷하게 설명했다. 서준이는 충분히 알아보지도 않고 판단한 자신의 편견을 돌아보았다.']
  ].forEach(([target,text])=>word(6,target,text));
  [
    ['비 오는 날','아침부터 비가 많이 내렸다.\n운동장 놀이를 교실 놀이로 바꾸었다.','그래서'],
    ['예상과 다른 결과','종이비행기를 멀리 날릴 수 있을 것이라고 예상했다.\n실제로는 발 앞에 떨어졌다.','그러나'],
    ['두 가지 장점','우리 도서관에는 재미있는 책이 많다.\n조용히 책을 읽을 자리도 넉넉하다.','또한'],
    ['구체적인 예','교실에서 쓰레기를 줄이는 방법은 여러 가지다.\n개인 물병을 가져와 일회용 컵 사용을 줄일 수 있다.','예를 들어'],
    ['작업의 순서','화분에 씨앗을 심었다.\n흙이 촉촉해지도록 물을 주었다.','그런 다음'],
    ['선택하는 상황','모둠 발표를 포스터로 준비할 수 있다.\n짧은 역할극으로 준비할 수도 있다.','또는'],
    ['필요한 조건','체육관을 사용하기 전에 예약해야 한다.\n다른 반과 시간이 겹치지 않게 이용할 수 있다.','그러면'],
    ['노력의 목적','친구들의 의견을 빠짐없이 적었다.\n학급 회의에서 모든 의견을 함께 살펴보고 싶었다.','~기 위해'],
    ['이유를 덧붙이기','이번 주에는 쉬는 시간마다 줄넘기를 연습하려고 한다.\n다음 주에 스스로 정한 목표에 도전하기 때문이다.','왜냐하면'],
    ['앞뒤 모습 비교','정리하기 전에는 준비물을 찾는 데 시간이 오래 걸렸다.\n정리한 뒤에는 필요한 물건을 바로 찾았다.','반면에']
  ].forEach(([title,text,target])=>sentence(5,title,text,target));
  [
    ['어려움과 실천','자료를 모으는 데 예상보다 많은 시간이 들었다.\n우리 모둠은 약속한 날짜까지 보고서를 완성했다.','그럼에도 불구하고'],
    ['서로 다른 특징','종이 안내문은 전자 기기 없이도 읽을 수 있다.\n온라인 안내문은 바뀐 내용을 빠르게 고칠 수 있다.','반면에'],
    ['자료에서 내린 판단','설문에 참여한 학생 대부분이 쉬는 자리의 부족을 지적했다.\n우리는 빈 공간을 휴식 장소로 바꾸자고 제안했다.','따라서'],
    ['조건을 분명히 하기','학교 구성원들이 정한 이용 약속을 지킨다.\n공용 공간을 함께 편리하게 사용할 수 있다.','~다면'],
    ['주장을 설명하는 사례','같은 문제에도 해결 방법은 다양하다.\n잃어버린 준비물을 줄이기 위해 이름표를 붙이거나 보관 장소를 정할 수 있다.','예를 들어'],
    ['정보를 더하기','행사 계획에는 진행 순서와 역할 분담이 필요하다.\n예상하지 못한 상황에 대비한 대안도 필요하다.','아울러'],
    ['핵심을 다시 말하기','서로의 제안을 듣고, 이유를 묻고, 함께 쓸 방법을 고쳤다.\n우리는 대화를 통해 공동의 해결책을 만든 것이다.','즉'],
    ['시간의 흐름','토론을 시작하기 전에 자료의 출처를 확인했다.\n토론이 끝난 뒤에는 처음 생각과 달라진 점을 기록했다.','이후'],
    ['닮은 관계 찾기','학급 회의에서는 모든 친구에게 의견을 말할 기회를 주어야 한다.\n모둠 회의에서도 특정 친구만 계속 말하지 않도록 해야 한다.','마찬가지로'],
    ['결정에 필요한 이유','우리는 안내문을 그림과 쉬운 문장으로 다시 만들었다.\n학교를 처음 방문한 사람도 내용을 이해할 수 있게 하려는 것이었다.','~도록']
  ].forEach(([title,text,target])=>sentence(6,title,text,target));
  [
    ['도서관의 약속','도서관에서는 읽은 책을 정해진 곳에 두어야 한다.\n큰 소리로 떠들지 않아야 다른 사람의 읽기를 방해하지 않는다.\n모두가 편하게 이용하려면 도서관의 약속을 함께 지켜야 한다.'],
    ['발표 준비','민지는 발표할 내용을 짧은 말로 정리했다.\n친구 앞에서 연습하며 설명이 어려운 부분을 고쳤다.\n발표를 잘하려면 내용을 정리하고 미리 연습하는 준비가 필요하다.'],
    ['관찰 기록','관찰한 내용을 그때그때 기록하면 변화를 자세히 알 수 있다.\n잎의 길이를 날짜별로 적으면 얼마나 자랐는지 비교할 수 있다.\n사진과 그림을 함께 남기면 모양의 변화도 다시 살펴볼 수 있다.'],
    ['분리배출','빈 우유갑에 남은 내용물을 비웠다.\n종이 상자에 붙은 테이프는 떼어 냈다.\n분리배출을 할 때는 재질에 맞게 나누고 붙어 있는 다른 물질도 살펴야 한다.'],
    ['말할 차례','친구의 말이 끝나기 전에 내 의견을 말하면 서로의 생각을 놓치기 쉽다.\n차례를 지켜 말하면 의견을 끝까지 듣고 대답할 수 있다.\n대화를 이어 가려면 말할 차례를 존중하는 태도가 필요하다.'],
    ['모르는 낱말','책에서 모르는 낱말을 만났다고 바로 읽기를 멈출 필요는 없다.\n앞뒤 문장에서 인물의 행동과 상황을 찾아보면 뜻을 짐작할 수 있다.\n짐작한 뜻이 자연스러운지 다시 읽고, 필요하면 사전으로 확인한다.'],
    ['하루 계획','하루 계획을 세울 때는 꼭 해야 할 일을 먼저 정하는 것이 좋다.\n준비물 챙기기와 숙제처럼 필요한 일을 적는다.\n그 뒤에 쉬는 시간과 하고 싶은 일을 넣으면 계획을 실천하기 수월하다.'],
    ['물 아끼기','양치할 때 컵을 사용하면 물을 계속 틀어 놓지 않아도 된다.\n비누칠을 하는 동안에도 수도꼭지를 잠글 수 있다.\n물을 아끼는 일은 생활 속 작은 습관에서 시작할 수 있다.'],
    ['실수에서 배우기','틀린 문제를 보고 답만 고치면 왜 틀렸는지 잊기 쉽다.\n어느 부분에서 생각이 달라졌는지 적어 보면 다음 풀이에 도움이 된다.\n실수를 돌아보고 까닭을 찾는 과정도 배움의 한 부분이다.'],
    ['익숙한 길의 발견','매일 걷는 길도 관심을 가지고 보면 새롭게 보인다.\n어제는 보지 못한 작은 꽃을 발견할 수 있다.\n나뭇잎의 색과 가게의 안내판이 달라진 모습도 눈에 들어온다.']
  ].forEach(([title,text])=>paragraph(5,title,text));
  [
    ['사실과 의견','정보를 읽을 때는 확인할 수 있는 사실과 사람의 의견을 구별해야 한다.\n행사에 백 명이 참여했다는 말은 자료로 확인할 수 있다.\n행사가 가장 재미있었다는 말에는 말한 사람의 판단이 담겨 있다.\n둘을 구별하면 글쓴이의 생각과 전달된 정보를 더 정확하게 이해할 수 있다.'],
    ['주장과 근거','토론에서 자신의 생각만 여러 번 말한다고 상대가 납득하는 것은 아니다.\n관련 자료나 구체적인 경험을 들어 주장을 뒷받침해야 한다.\n또한 그 자료가 주장과 어떻게 이어지는지도 설명해야 한다.\n설득력 있는 토론을 하려면 주장에 맞는 근거와 그에 대한 설명이 필요하다.'],
    ['공정한 규칙','규칙을 모두에게 똑같이 적용하는 것만으로 해결되지 않는 상황도 있다.\n글씨를 읽기 어려운 친구에게는 안내문을 소리로 들려줄 수 있다.\n이렇게 참여에 필요한 도움을 제공해야 같은 활동에 함께할 수 있다.\n공정한 규칙을 만들 때는 사람마다 다른 상황과 필요한 도움도 고려해야 한다.'],
    ['숫자의 비교','두 자료의 숫자를 비교하기 전에는 조사한 기준을 확인해야 한다.\n한 자료가 한 반의 응답이고 다른 자료가 학교 전체의 응답이라면 인원수만 바로 비교하기 어렵다.\n조사한 시기나 질문이 달라도 결과의 뜻이 달라질 수 있다.\n숫자와 함께 조사 대상, 시기, 질문을 살펴야 적절하게 비교할 수 있다.'],
    ['다른 관점 이해하기','새 놀이터를 만들자는 제안에 학생은 놀 공간이 늘어난다고 반겼다.\n주민은 공사 중 통행이 불편해질 수 있다는 점을 걱정했다.\n같은 제안도 각자의 처지에 따라 다르게 받아들일 수 있다.\n서로의 처지를 묻고 듣는 과정은 해결책을 더 넓게 찾는 데 도움이 된다.'],
    ['정보의 출처','온라인에서 본 내용을 바로 믿기 전에 누가 언제 어떤 자료를 바탕으로 썼는지 확인해야 한다.\n제목이 눈에 띈다고 내용까지 정확한 것은 아니다.\n다른 자료와 비교하면 빠지거나 다르게 전해진 부분을 찾을 수 있다.\n출처를 살피고 내용을 대조하는 습관은 정보를 판단할 때 도움이 된다.'],
    ['의견 모으기','의견을 모을 때는 가장 큰 목소리만 기록해서는 안 된다.\n말하기 어려워하는 사람에게는 글로 의견을 낼 기회도 줄 수 있다.\n비슷한 의견을 묶되 서로 다른 까닭도 함께 남겨야 한다.\n여러 사람의 생각을 고르게 듣고 차이를 살피는 과정이 의견 수렴에 필요하다.'],
    ['요약의 기준','글을 짧게 줄인다고 모두 알맞은 요약이 되는 것은 아니다.\n예시만 남기고 중심 생각을 빼면 글쓴이의 뜻이 달라질 수 있다.\n중요한 내용 사이의 관계를 살리고 반복되는 예는 줄여야 한다.\n좋은 요약은 글의 중심 생각과 핵심 관계를 간결하게 담는다.'],
    ['선택의 결과','학급 예산으로 책을 더 살지 놀이 도구를 살지 결정해야 했다.\n두 선택 모두 장점이 있지만 예산이 한정되어 한쪽을 고르면 다른 쪽은 줄여야 했다.\n선택할 때는 얻는 점뿐 아니라 포기하는 점도 함께 따져야 한다.\n우리는 각 선택의 결과를 비교한 뒤 우선 필요한 물건을 정했다.'],
    ['질문을 발전시키기','처음에는 우리 동네에 가게가 몇 개인지만 궁금했다.\n관찰한 뒤에는 왜 큰길 주변에 가게가 모이는지도 궁금해졌다.\n사실을 확인하는 질문에서 까닭과 관계를 묻는 질문으로 생각이 넓어진 것이다.\n자료를 읽고 관찰한 내용을 바탕으로 질문을 발전시키면 탐구를 깊게 할 수 있다.']
  ].forEach(([title,text])=>paragraph(6,title,text));
  return out.map((item,index)=>({...item,request_id:'bank-20261024-'+item.grade+'-'+item.kind+'-'+index,source_note:'직접 작성한 '+item.grade+'학년 문해 기초 예시'}));
}

function addLiteracyActivities(){
  if(!Session.getActiveUser().getEmail()||Session.getActiveUser().getEmail()!==Session.getEffectiveUser().getEmail())throw new Error('시트 소유 계정에서 실행하세요.');
  const lock=LockService.getScriptLock();lock.waitLock(20000);
  try{
    const all=rows_('tasks'),seen=new Set(all.map(t=>t.request_id));let id=next_(all,'id');
    const bank=literacyBank_().filter(t=>!seen.has(t.request_id)),headers=TABLES_.tasks[1];
    const values=bank.map(t=>{const row={...t,id:id++,day:day_(),school_id:''};return headers.map(k=>{const v=String(row[k]==null?'':row[k]);return /^[=+\-@]/.test(v)?"'"+v:v;});});
    const sheet=book_().getSheetByName('활동');
    if(values.length){const start=sheet.getLastRow()+1;sheet.getRange(start,1,values.length,headers.length).setNumberFormat('@').setValues(values);sheet.autoResizeRows(start,values.length);}
    SpreadsheetApp.flush();console.log('추가 완료: '+values.length+'개. 5·6학년 각 영역 10개씩, 총 60개 원본 활동. 기존 활동과 답안은 보존했습니다.');
  }finally{lock.releaseLock();}
}
